# CyberEscape Backend Environment Variables (Render)

# Environment mode ('development' or 'production')
NODE_ENV=production

# Server Port (Render sets process.env.PORT automatically)
PORT=5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/cyberescape?retryWrites=true&w=majority

# Secret key for JWT signing (use a long, unique random string)
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# JWT expiration period (e.g., 7d, 24h)
JWT_EXPIRES_IN=7d

# Allowed frontend origins for CORS (comma-separated, without trailing slashes)
CLIENT_URL=https://your-app.vercel.app,http://localhost:5173
